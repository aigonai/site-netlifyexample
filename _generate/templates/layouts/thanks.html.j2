{#- The page a form sends people to: what happened, and the way back. -#}
{% extends "base.html.j2" %}
{% from "partials/lucide.html.j2" import icon %}
{% block meta %}<meta name="robots" content="noindex">{% endblock %}
{% block main %}
<section class="page-head thanks">
  <div class="container narrow">
    <p class="thanks-icon">{{ icon('check', 'Sent') }}</p>
    <h1>{{ page.title }}</h1>
    <div class="lead prose">{{ page.body | safe }}</div>
    <p class="actions"><a class="button button-secondary" href="{{ section.path }}">Back to {{ section.title | lower }}</a></p>
  </div>
</section>
{% endblock %}
